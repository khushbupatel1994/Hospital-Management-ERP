# Copy to .env.production and replace EVERY placeholder.
ERP_API_KEY=GENERATE_A_LONG_RANDOM_VALUE
ERP_JWT_SECRET=GENERATE_A_64_PLUS_CHARACTER_RANDOM_VALUE
ERP_JWT_MINUTES=30
ERP_BOOTSTRAP_USERNAME=admin
ERP_BOOTSTRAP_PASSWORD=SET_ON_FIRST_DEPLOY_THEN_REMOVE
ERP_DEMO_MODE=false
ERP_BACKUP_DIR=/app/backups
POSTGRES_DB=hospital_erp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_VALUE
POSTGRES_DSN=postgresql://erp_app:REPLACE@postgres:5432/hospital_erp
REDIS_URL=redis://redis:6379/0
ERP_REQUIRE_TLS=true
ERP_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app
OPENAI_API_KEY=SERVER_SIDE_ONLY
