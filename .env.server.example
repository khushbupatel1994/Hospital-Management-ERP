# Copy to .env on the PRIVATE API SERVER. Never ship this file with the hospital client.
ERP_API_KEY=replace-with-long-random-client-key
ERP_JWT_SECRET=replace-with-32-plus-character-random-secret
ERP_JWT_MINUTES=30
ERP_BOOTSTRAP_USERNAME=admin
ERP_BOOTSTRAP_PASSWORD=set-on-first-deploy-then-remove
ERP_DEMO_MODE=false
HOSPITAL_DB=C:\HospitalERP\server-data\hospital.db
ERP_ALLOWED_ORIGINS=https://erp.example.com
